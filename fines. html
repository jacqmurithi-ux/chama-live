<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Fines | CHAMA LIVE</title>

  <style>
    :root {
      --primary: #166534;
      --primary-dark: #14532d;
      --bg: #f8fafc;
      --surface: #ffffff;
      --border: #e2e8f0;
      --text: #0f172a;
      --muted: #64748b;
      --danger: #b91c1c;
      --danger-bg: #fef2f2;
      --success: #166534;
      --success-bg: #f0fdf4;
      --warning: #92400e;
      --warning-bg: #fffbeb;
      --info: #1d4ed8;
      --info-bg: #eff6ff;
      --shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
      --radius: 12px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .topbar-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: var(--primary);
      color: #fff;
      font-weight: 800;
      font-size: 18px;
    }

    .brand-copy {
      min-width: 0;
    }

    .brand-name {
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .brand-group {
      color: var(--muted);
      font-size: 13px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 360px;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      padding: 9px 14px;
      border-radius: 9px;
      font-weight: 650;
    }

    .btn:hover {
      background: #f8fafc;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
    }

    .btn-danger {
      background: #fff;
      color: var(--danger);
      border-color: #fecaca;
    }

    .layout {
      max-width: 1400px;
      margin: 0 auto;
      padding: 28px 24px 48px;
    }

    .main {
      min-width: 0;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 24px;
    }

    .page-title {
      margin: 0;
      font-size: 28px;
      line-height: 1.15;
      letter-spacing: -0.03em;
    }

    .page-subtitle {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 14px;
      max-width: 760px;
    }

    .message {
      margin-bottom: 16px;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 14px;
    }

    .message:empty {
      display: none;
    }

    .status {
      background: var(--success-bg);
      border: 1px solid #bbf7d0;
      color: var(--success);
    }

    .error {
      background: var(--danger-bg);
      border: 1px solid #fecaca;
      color: var(--danger);
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .summary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px;
      box-shadow: var(--shadow);
    }

    .summary-label {
      color: var(--muted);
      font-size: 13px;
      font-weight: 650;
      margin-bottom: 8px;
    }

    .summary-value {
      font-size: 26px;
      line-height: 1.1;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      margin-bottom: 24px;
      overflow: hidden;
    }

    .section-header {
      padding: 18px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .section-title {
      margin: 0;
      font-size: 18px;
    }

    .section-body {
      padding: 20px;
    }

    .filters {
      display: grid;
      grid-template-columns:
        minmax(220px, 1fr)
        minmax(170px, 220px)
        minmax(170px, 220px)
        auto;
      gap: 10px;
      align-items: end;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .filter-group label {
      font-size: 13px;
      font-weight: 700;
      color: #334155;
    }

    .filter-group input,
    .filter-group select {
      width: 100%;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: var(--text);
      border-radius: 9px;
      padding: 10px 12px;
      outline: none;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1100px;
    }

    th,
    td {
      padding: 13px 14px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: middle;
      font-size: 14px;
    }

    th {
      background: #f8fafc;
      color: #475569;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 800;
    }

    tbody tr:hover {
      background: #f8fafc;
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    .money {
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .muted {
      color: var(--muted);
    }

    .member-name {
      font-weight: 750;
    }

    .fine-name {
      font-weight: 650;
    }

    .fine-meta {
      margin-top: 3px;
      color: var(--muted);
      font-size: 12px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 9px;
      font-size: 12px;
      font-weight: 750;
      white-space: nowrap;
    }

    .badge-paid {
      background: #dcfce7;
      color: #166534;
    }

    .badge-partial {
      background: var(--info-bg);
      color: var(--info);
    }

    .badge-outstanding {
      background: var(--warning-bg);
      color: var(--warning);
    }

    .badge-waived {
      background: #f1f5f9;
      color: #475569;
    }

    .row-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .row-actions .btn {
      padding: 7px 10px;
      font-size: 12px;
    }

    .empty-state {
      padding: 42px 20px;
      text-align: center;
      color: var(--muted);
    }

    .empty-state strong {
      display: block;
      color: var(--text);
      margin-bottom: 6px;
    }

    .detail-panel {
      display: none;
    }

    .detail-panel.open {
      display: block;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .detail-item {
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #f8fafc;
    }

    .detail-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .detail-value {
      font-size: 14px;
      font-weight: 700;
      word-break: break-word;
    }

    .detail-balance {
      margin-top: 18px;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
    }

    .balance-item {
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .balance-label {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 5px;
    }

    .balance-value {
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }

    @media (max-width: 1000px) {
      .summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .filters {
        grid-template-columns: 1fr 1fr;
      }

      .detail-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .detail-balance {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .topbar-inner {
        padding: 12px 16px;
      }

      .layout {
        padding: 20px 16px 36px;
      }

      .page-header {
        flex-direction: column;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }

      .filters {
        grid-template-columns: 1fr;
      }

      .detail-grid,
      .detail-balance {
        grid-template-columns: 1fr;
      }

      .brand-group {
        max-width: 180px;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    <div class="topbar-inner">

      <div class="brand">
        <div class="brand-mark">CL</div>

        <div class="brand-copy">
          <div class="brand-name">CHAMA LIVE</div>

          <div
            class="brand-group"
            data-group-name
          >
            Loading group…
          </div>
        </div>
      </div>

      <div class="topbar-actions">
        <button
          type="button"
          class="btn btn-danger"
          id="logout"
        >
          Logout
        </button>
      </div>

    </div>

    <nav
      class="top-nav"
      aria-label="Admin navigation"
    ></nav>
  </header>


  <div class="layout">

    <main class="main">

      <div class="page-header">
        <div>
          <h1 class="page-title">
            Fines
          </h1>

          <p class="page-subtitle">
            View fines and their authoritative accounting balances.
            This page is read-only.
          </p>
        </div>

        <button
          type="button"
          class="btn btn-primary"
          id="refreshFines"
        >
          Refresh
        </button>
      </div>


      <div
        id="status"
        class="message status"
        aria-live="polite"
      ></div>

      <div
        id="error"
        class="message error"
        role="alert"
        aria-live="assertive"
      ></div>


      <section
        class="summary-grid"
        aria-label="Fine summary"
      >

        <article class="summary-card">
          <div class="summary-label">
            Total Fines
          </div>

          <div
            class="summary-value"
            id="totalFines"
          >
            0
          </div>
        </article>


        <article class="summary-card">
          <div class="summary-label">
            Original Amount
          </div>

          <div
            class="summary-value money"
            id="totalOriginal"
          >
            KSh 0
          </div>
        </article>


        <article class="summary-card">
          <div class="summary-label">
            Paid
          </div>

          <div
            class="summary-value money"
            id="totalPaid"
          >
            KSh 0
          </div>
        </article>


        <article class="summary-card">
          <div class="summary-label">
            Outstanding
          </div>

          <div
            class="summary-value money"
            id="totalOutstanding"
          >
            KSh 0
          </div>
        </article>

      </section>


      <section
        class="section"
        aria-labelledby="filters-title"
      >

        <div class="section-header">
          <h2
            class="section-title"
            id="filters-title"
          >
            Filters
          </h2>
        </div>

        <div class="section-body">

          <div class="filters">

            <div class="filter-group">
              <label for="fineSearch">
                Search
              </label>

              <input
                type="search"
                id="fineSearch"
                placeholder="Search member, rule, or trigger…"
                autocomplete="off"
              >
            </div>


            <div class="filter-group">
              <label for="monthFilter">
                Accounting Month
              </label>

              <select id="monthFilter">
                <option value="">
                  All months
                </option>
              </select>
            </div>


            <div class="filter-group">
              <label for="statusFilter">
                Status
              </label>

              <select id="statusFilter">
                <option value="">
                  All statuses
                </option>

                <option value="OUTSTANDING">
                  Outstanding
                </option>

                <option value="PARTIALLY_PAID">
                  Partially Paid
                </option>

                <option value="PAID">
                  Paid
                </option>

                <option value="WAIVED">
                  Waived
                </option>
              </select>
            </div>


            <div>
              <button
                type="button"
                class="btn"
                id="clearFilters"
              >
                Clear
              </button>
            </div>

          </div>

        </div>

      </section>


      <section
        class="section"
        aria-labelledby="fines-title"
      >

        <div class="section-header">

          <h2
            class="section-title"
            id="fines-title"
          >
            Fine Register
          </h2>

          <span
            class="muted"
            id="resultCount"
          >
            0 fines
          </span>

        </div>


        <div class="table-wrap">

          <table>

            <thead>
              <tr>
                <th>Member</th>
                <th>Fine</th>
                <th>Month</th>
                <th>Original</th>
                <th>Adjusted</th>
                <th>Waived</th>
                <th>Paid</th>
                <th>Outstanding</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody id="finesBody">

              <tr>
                <td
                  colspan="10"
                  class="empty-state"
                >
                  Loading fines…
                </td>
              </tr>

            </tbody>

          </table>

        </div>

      </section>


      <section
        class="section detail-panel"
        id="fineDetail"
        aria-labelledby="detail-title"
      >

        <div class="section-header">

          <h2
            class="section-title"
            id="detail-title"
          >
            Fine Details
          </h2>

          <button
            type="button"
            class="btn"
            id="closeDetail"
          >
            Close
          </button>

        </div>


        <div class="section-body">

          <div
            class="detail-grid"
            id="detailGrid"
          ></div>


          <div
            class="detail-balance"
            id="detailBalance"
          ></div>

        </div>

      </section>

    </main>

  </div>


  <script type="module">
    import { boot } from "./js/admin-layout.js";

    boot();
  </script>

</body>
</html>
